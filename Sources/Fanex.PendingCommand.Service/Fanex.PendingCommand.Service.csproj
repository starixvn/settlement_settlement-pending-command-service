<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
	<ItemGroup>
		<None Remove="appsettings.Development.json" />
		<None Remove="appsettings.json" />
		<None Remove="appsettings.KLDR.json" />
		<None Remove="appsettings.LOCAL.json" />
		<None Remove="appsettings.PROD.json" />
		<None Remove="appsettings.SIT.json" />
		<None Remove="appsettings.UAT.json" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="appsettings.KLDR.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Development.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.LOCAL.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.PROD.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.SIT.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.UAT.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="App_Data\SpName.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.8" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.3" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.3" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
    <PackageReference Include="ONEbook.UM" Version="3.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.PendingCommand\Fanex.PendingCommand.csproj" />
  </ItemGroup>

</Project>
